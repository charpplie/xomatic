    CONTROL         "Hide <CUSTOM> preset",IDC_HIDE_CUSTOM_CB,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,38,93,10
    CONTROL         "Show Output Window",IDC_SHOW_WINDOW_CB,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,51,85,10
END

IDD_EDITOR_DIALOG DIALOGEX 0, 0, 224, 125
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD | WS_SYSMENU
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "Prefer 32 Bit Editor",IDC_32BIT_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,7,77,10
    EDITTEXT        IDC_EXPORT_KEY_0,15,48,31,14,ES_AUTOHSCROLL | NOT WS_VISIBLE
    EDITTEXT        IDC_EXPORT_KEY_1,49,48,31,14,ES_AUTOHSCROLL | NOT WS_VISIBLE
    EDITTEXT        IDC_EXPORT_KEY_2,83,48,31,14,ES_AUTOHSCROLL | NOT WS_VISIBLE
