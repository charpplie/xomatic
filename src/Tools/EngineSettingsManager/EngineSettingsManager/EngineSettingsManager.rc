    EDITTEXT        IDC_SERVER_EDIT,7,18,186,14,ES_AUTOHSCROLL
    LTEXT           "r_ShaderCompilerServer:",IDC_SERVER_STATIC,7,7,82,8
    LTEXT           "Static",IDC_INFO_STATIC,15,60,170,26
END

IDD_LICENSE_DIALOG DIALOGEX 0, 0, 207, 141
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD | WS_SYSMENU
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "License Server selection",IDC_STATIC,11,9,78,8
    GROUPBOX        "",IDC_STATIC,17,20,179,44
