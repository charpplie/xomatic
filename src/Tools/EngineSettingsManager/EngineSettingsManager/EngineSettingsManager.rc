    EDITTEXT        IDC_LICENSE_KEY_2,114,46,31,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_LICENSE_KEY_3,148,46,31,14,ES_AUTOHSCROLL
    GROUPBOX        "",IDC_STATIC,17,63,179,47
    CONTROL         "Internal",IDC_LICENSE_MANUAL,"Button",BS_AUTORADIOBUTTON,24,68,41,10
    LTEXT           "Server IP",IDC_STATIC,49,79,42,8
    CONTROL         "",IDC_LICENSE_IPADDRESS,"SysIPAddress32",WS_TABSTOP,46,91,98,15
    LTEXT           "Port",IDC_STATIC,148,79,42,8
    EDITTEXT        IDC_LICENSE_PORT,147,91,40,14,ES_AUTOHSCROLL | ES_NUMBER
