IDD_RC_DIALOG DIALOGEX 0, 0, 200, 100
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD | WS_SYSMENU
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Parameters (e.g. ""/showdialog=0 /...""):",IDC_STATIC,7,7,128,8
