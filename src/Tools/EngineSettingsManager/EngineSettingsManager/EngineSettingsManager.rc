    PUSHBUTTON      "Reset",IDC_RESET_BUTTON,155,48,53,15,NOT WS_VISIBLE
END

IDD_SETTINGSDIALOG DIALOGEX 0, 0, 200, 100
STYLE DS_SETFONT | WS_CHILD | WS_SYSMENU
FONT 8, "MS Sans Serif", 0, 0, 0x0
BEGIN
    LTEXT           "Root Directory (The path which contains /Bin32):",IDC_STATIC,7,7,156,8
    EDITTEXT        IDC_ROOT_PATH,7,17,160,14,ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON      "...",IDC_BROWSE_BUTTON,171,17,22,14
    GROUPBOX        "Engine State",IDC_STATIC,7,60,186,33
    ICON            IDI_GREEN_ICON,IDC_RC_STATE,11,70,20,20
    LTEXT           "rc.exe found!",IDC_RC_STATE_LABEL,35,75,92,8
END

IDD_SC_DIALOG DIALOGEX 0, 0, 200, 100
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD | WS_SYSMENU
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
