/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Open Log\tCtrl+O",           ID_FILE_OPEN
        MENUITEM "&Export to XLS",              ID_FILE_EXPORTTOXLS
        MENUITEM SEPARATOR
        MENUITEM "Recent File",                 ID_FILE_MRU_FILE1, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Copy",                       ID_EDIT_COPY
        MENUITEM SEPARATOR
        MENUITEM "&Find",                       ID_EDIT_FIND
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Combined Usage",             ID_COMBINED
        MENUITEM "&Main Usage",                 ID_MAIN
        MENUITEM "&RSX Usage",                  ID_RSX
    END
    POPUP "&Tools"
    BEGIN
        MENUITEM "&Look up type...",            ID_TYPEINFO_LOOKUP
        MENUITEM "&Validate allocations",       ID_TOOLS_VALIDATEALLOCATIONS
        MENUITEM "Find sizers",                 ID_TOOLS_FINDSIZERS
        MENUITEM "Find &overrun sizers",        ID_TOOLS_FINDOVERRUNSIZERS
        MENUITEM "Analyse &buckets",            ID_TOOLS_ANALYSEBUCKETS
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About memReplay...",         ID_APP_ABOUT
    END
END


