{
	LOG_CODE_COVERAGE();
	switch (event)
	{
	case ESYSTEM_EVENT_RANDOM_SEED:
		//g_random_generator.seed((uint32)wparam);
		break;

	case ESYSTEM_EVENT_LEVEL_POST_UNLOAD:
		{
			STLALLOCATOR_CLEANUP;
			break;
		}
	}
}

