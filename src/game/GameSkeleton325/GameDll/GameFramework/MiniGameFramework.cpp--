bool	simpleframework::CMiniGameFramework::IsGamePaused()
{
	LOG_CODE_COVERAGE();

	CRY_ASSERT(gEnv);
	CRY_SAFE_RETURN(!gEnv, false);

	CRY_ASSERT(gEnv->pTimer);
	CRY_SAFE_RETURN(!gEnv->pTimer, false);

	return m_ePauseState || !gEnv->pTimer->IsTimerEnabled();	
}

