		else
			pCmdUI->SetCheck(FALSE);		
	}
	static void CreateMenu( CMenu &menu )
	{
		menu.CreatePopupMenu();

		for (int i = 0; i < steps; i++)
		{
			CString str;
			str.Format( "%d",anglesArray[i] );
			menu.AppendMenu( MF_STRING,ID_SNAP_TO_ANGLE_RANGE_BEGIN+i,str );
