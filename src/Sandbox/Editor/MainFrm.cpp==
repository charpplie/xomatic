	if (!pControl)
		return;

	int sel = pControl->GetCurSel();
	if (sel == LB_ERR || sel == pControl->GetCount()-1)
	{
		sel = 0;
	}
	else
		sel++;
	pControl->SetCurSel(sel);

	if (sel != LB_ERR)
	{
		gSettings.objectSelectMask = pControl->GetItemData(sel);
		m_objectSelectionMask = gSettings.objectSelectMask;
	}
}

