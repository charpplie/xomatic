{
	int index = m_wndStatusBar.CommandToIndex(ID_INDICATOR_BACKGROUNDACTIVITY);

	if (!m_pBGTasks || m_pBGTasks->m_bIdle)
	{
		m_wndStatusBar.GetPane(index)->SetText("Idle");
		m_wndStatusBar.GetPane(index)->SetTooltip("No background tasks running");
		m_wndStatusBar.GetPane(index)->SetIconIndex(IDI_BALL_DISABLED);
	}
	else if (m_pBGTasks->m_bHasFailures)
	{
		CString bginfo;	
		CString fails;

		bginfo.Format("%d/%d", m_pBGTasks->m_nTasksPending, m_pBGTasks->m_sFailures.size());
		fails.Format("%d background tasks running\n%d failed compiles:\n", m_pBGTasks->m_nTasksPending, m_pBGTasks->m_sFailures.size());

		std::set<string>::const_iterator walk;
		for (walk = m_pBGTasks->m_sFailures.begin(); walk != m_pBGTasks->m_sFailures.end(); walk++)
		{
			fails += *walk + "\n";
		}

		m_wndStatusBar.GetPane(index)->SetText(bginfo);
		m_wndStatusBar.GetPane(index)->SetTooltip(fails);
		m_wndStatusBar.GetPane(index)->SetIconIndex(m_pBGTasks->m_bHasFailures ? IDI_BALL_OFFLINE : IDI_BALL_PENDING);
	}
	else
	{
		CString bginfo;

		bginfo.Format("%d", m_pBGTasks->m_nTasksPending);

		m_wndStatusBar.GetPane(index)->SetText(bginfo);
		m_wndStatusBar.GetPane(index)->SetTooltip(bginfo + " background tasks running");
		m_wndStatusBar.GetPane(index)->SetIconIndex(m_pBGTasks->m_bHasFailures ? IDI_BALL_OFFLINE : IDI_BALL_PENDING);
	}
}

