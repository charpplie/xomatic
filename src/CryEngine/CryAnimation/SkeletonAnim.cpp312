void CSkeletonAnim::PushLayer(IAnimationLayer* pLayer)
{
	if (IAnimationPoseModifier* pPoseModifier = cryinterface_cast<IAnimationPoseModifier>(pLayer))
	{
		m_pSkeletonPose->m_poseModifiers.push_back(pPoseModifier);
	}
}
